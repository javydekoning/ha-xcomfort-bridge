{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "pre-commit": {
    "enabled": true
  },
  "ignorePaths": [".github/linters/pyproject.toml"],
  "regexManagers": [
    {
      "fileMatch": ["manifest\\.json$"],
      "matchStrings": [
        "\"(?<package>[^@\\s\"]+)@(?<currentValue>[^#\\s\"]+)#[^\"]*\"",
        "\"(?<package>[^@\\s\"]+)==(?<currentValue>[^\\s\",]+)\""
      ],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "{{{package}}}",
      "versioningTemplate": "pep440"
    }
  ],
  "packageRules": [
    {
      "description": "pycryptodome is shared with HA core and other integrations; keep a loose range that HA's bundled version satisfies instead of pinning (pinning 4.x broke roborock and xcomfort at runtime)",
      "matchPackageNames": ["pycryptodome"],
      "enabled": false
    }
  ]
}
